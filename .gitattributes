# 安装脚本必须在 Linux 上以 LF 运行，CRLF 会导致
# "bad interpreter: /usr/bin/env^M" 这种莫名其妙的报错
*.sh text eol=lf

# Go 源码和 YAML 统一 LF，避免 CI 上 gofmt / 解析差异
*.go text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 仓库里的 Python 是给 CI / 本地自检用的脚本，统一 LF 少一层平台差异
*.py text eol=lf

# web/dist 是提交进仓库的构建产物，CI 会用 Linux 上重新构建的结果跟它逐字节比对。
# 如果本地是 Windows（core.autocrlf=false）把 CRLF 提上去，CI 会误判成「产物过期」，
# 所以这里强制按 LF 存储，保证不同平台提交/检出后字节一致。
web/dist/** text eol=lf
